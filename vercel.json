    },
    {
      "source": "/((?!api/|robots\\.txt|sitemap\\.xml|favicon\\.ico|apple-touch-icon\\.png|icon-192\\.png|icon-512\\.png|manifest\\.webmanifest|service-worker\\.js|vite\\.svg|assets/|arizona(?:/.*)?$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    { "source": "/my-trips/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] },
    { "source": "/my-trips", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] }
  ]
}
