{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",

  "functions": {
    "api/**/*.ts": {
      "runtime": "nodejs18.x"
    }
  },

  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
