# Server-only environment variables. Never commit real values.
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
SESSION_SECRET=
AGODA_AFFILIATE_URL=
GETYOURGUIDE_AFFILIATE_URL=
ALLTRAILS_AFFILIATE_URL=
REI_AFFILIATE_URL=

# Generate SESSION_SECRET with at least 32 random bytes.
# Example: openssl rand -base64 48

# Public delivery settings used by the Vite app and safe to configure in Vercel.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_FOLDER=sage/arizona

# Server-only upload credentials. Never prefix these with VITE_ or commit real values.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=sage/arizona

# Public cross-site destinations. Use the newsletter platform's exact subscribe URL.
VITE_NEWSLETTER_URL=https://newsletter.healthandtravels.com
VITE_NEWSLETTER_SUBSCRIBE_URL=https://newsletter.healthandtravels.com
