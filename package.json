{
  "name": "sage-suite-hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-sitemap.mjs && tsc && vite build && node scripts/prerender.mjs && node scripts/prerender-public-pages.mjs",
    "cloudinary:upload": "node scripts/upload-cloudinary-images.mjs",
    "cloudinary:inbox": "node scripts/upload-cloudinary-inbox.mjs",
    "cloudinary:catalog": "node scripts/sync-cloudinary-catalog.mjs",
    "cloudinary:catalog:local": "node scripts/sync-cloudinary-catalog.mjs --local",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.3.0",
    "lucide-react": "^0.284.0",
    "motion": "^11.11.13",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-markdown": "^9.0.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.0",
    "svix": "^2.8.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^25.3.5",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.15",
    "postcss": "^8.4.28",
    "tailwindcss": "^3.3.3",
    "typescript": "^7.0.2",
    "vite": "^6.4.4"
  }
}
